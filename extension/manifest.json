{
  "manifest_version": 3,
  "name": "LifeOS Tasks",
  "short_name": "LifeOS",
  "version": "1.2.0",
  "description": "Your LifeOS tasks one click away: what is due, tick it off, add one. As a popup or in the side panel.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LifeOS tasks",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "side_panel": { "default_path": "popup.html?panel=1" },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "sidePanel", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open LifeOS tasks (popup)"
    },
    "open-side-panel": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open LifeOS tasks in the side panel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
