# Copy to .env for local development (the API reads real environment variables; use your shell,
# `docker compose`, or `node --env-file=.env`).
DATABASE_URL=postgres://lifeos:lifeos-dev-password@localhost:5433/lifeos
PORT=3001
COOKIE_SECURE=0
ALLOW_REGISTRATION=0
POSTGRES_PASSWORD=lifeos-dev-password

# Production (Render + Neon) -- set these in the Render dashboard, not here:
#   DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   COOKIE_SECURE=1      (HTTPS only)
#   TRUST_PROXY=1        (one reverse proxy in front; makes login rate limits use the real client IP)
